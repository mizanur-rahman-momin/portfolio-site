# ---------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env.local` for local development, and set the same values
# in your hosting provider's dashboard for production.
#
# `.env.local` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public canonical origin of the site, without a trailing slash.
# Used for canonical URLs, Open Graph URLs, the sitemap, robots.txt and RSS.
# Local development:  http://localhost:3000
# Production:         https://mizanursguide.com  (set this before publishing —
#                     without it, canonicals and Open Graph URLs point at localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown on the contact page and in the RSS feed.
# Prefixed with NEXT_PUBLIC_ because it is rendered in the browser.
# Use an address you are happy to publish.
NEXT_PUBLIC_CONTACT_EMAIL=mizanur@convodigital.com

# Delivery endpoint for the contact form. The form POSTs JSON to this URL.
#
# Leave empty to disable delivery: the form still validates input and shows the
# visitor an error plus your NEXT_PUBLIC_CONTACT_EMAIL as a fallback. Nothing is
# sent anywhere.
#
# Any endpoint that accepts a JSON POST works, for example:
#   - Formspree:  https://formspree.io/f/xxxxxxxx
#   - Your own API route or serverless function
#   - An automation webhook (Zapier, Make, n8n)
CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Analytics is intentionally not installed. If you add a provider, prefer a
# privacy-conscious option and load it after hydration. Example:
#   NEXT_PUBLIC_ANALYTICS_ID=
#
# Newsletter signup URL. When set, the newsletter block links to your provider
# instead of the RSS fallback. Example: https://buttondown.email/your-handle
NEXT_PUBLIC_NEWSLETTER_URL=

# Convo Digital website URL. When set, it is used as the `url` of the
# Organization node in structured data. Leave empty to omit it.
# Example: https://convodigital.com
NEXT_PUBLIC_ORGANIZATION_URL=
